# Browser-visible variables (safe to expose)
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional UI-side admin hint; server auth uses ADMIN_EMAIL and/or role metadata.
VITE_ADMIN_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_COUPON_CODE=

# Server-only variables (never expose to browser)
DATABASE_URL=YOUR_SERVER_ONLY_DATABASE_URL
SUPABASE_URL=YOUR_SERVER_ONLY_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=uploads
ADMIN_EMAIL=

# Optional serverless tuning
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000
DB_MAX_USES=5000
UPLOAD_MAX_BYTES=4194304